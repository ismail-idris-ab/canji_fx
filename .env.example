# Copy to .env and fill in. .env is gitignored; this file is committed.
#
# Both values below are client-side by design and safe to ship in the app
# bundle. The service role key is NOT listed here on purpose: it bypasses
# every row-level security policy and belongs only in the Supabase Edge
# Function environment, set through the dashboard.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable-anon-key>
